{
  "manifest_version": 1,
  "package": "@next-bricks/vs",
  "name": "vs",
  "bricks": [
    {
      "name": "vs.code-editor",
      "properties": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "label",
          "type": "string"
        },
        {
          "name": "value",
          "type": "string"
        },
        {
          "name": "language",
          "description": "",
          "default": "\"plaintext\"",
          "type": "string"
        },
        {
          "name": "theme",
          "description": "主题，支持 `\"auto\" | \"vs\" | \"vs-dark\"`",
          "default": "\"auto\"",
          "type": "string"
        },
        {
          "name": "required",
          "type": "boolean"
        },
        {
          "name": "readOnly",
          "type": "boolean"
        },
        {
          "name": "automaticLayout",
          "type": "\"fit-container\" | \"fit-content\" | \"none\""
        },
        {
          "name": "minLines",
          "description": "",
          "default": "3",
          "type": "number"
        },
        {
          "name": "completers",
          "description": "仅对 language 为 brick_next_yaml 有效，设置第一层属性名的自动补全。",
          "attribute": false,
          "type": "monaco.languages.CompletionItem[]"
        },
        {
          "name": "advancedCompleters",
          "description": "高级自动补全配置。\n- 设置为键值对时，仅对 language 为 brick_next_yaml 有效，设置任意的自动补全；\n- 设置为数组时，当前仅对 language 为 cel 有效。\n未来将统一改为数组格式，废弃键值对格式的配置。",
          "attribute": false,
          "type": "AdvancedCompleterMap | MixedCompleter[]"
        },
        {
          "name": "markers",
          "attribute": false,
          "type": "Marker[]"
        },
        {
          "name": "links",
          "attribute": false,
          "type": "string[]"
        },
        {
          "name": "maxLines",
          "description": "",
          "default": "Infinity",
          "type": "number"
        },
        {
          "name": "height",
          "attribute": false,
          "type": "string | number"
        },
        {
          "name": "message",
          "type": "string"
        },
        {
          "name": "placeholder",
          "type": "string"
        },
        {
          "name": "showExpandButton",
          "description": "是否展示展开按钮",
          "type": "boolean"
        },
        {
          "name": "lineNumbers",
          "description": "行数配置",
          "type": "monaco.editor.LineNumbersType"
        },
        {
          "name": "tokenConfig",
          "description": "自定义高亮配置",
          "attribute": false,
          "type": "TokenConfig"
        },
        {
          "name": "customValidationInBrickNextYaml",
          "description": "在 brick_next_yaml 中是否开启语义相关校验",
          "default": "false",
          "type": "boolean"
        },
        {
          "name": "showCopyButton",
          "description": "是否展示复制按钮",
          "default": "true",
          "type": "boolean"
        },
        {
          "name": "glyphMargin",
          "description": "显示字形边距",
          "default": "false",
          "type": "boolean"
        },
        {
          "name": "extraLibs",
          "description": "额外声明的 lib 库",
          "attribute": false,
          "type": "ExtraLib[]"
        },
        {
          "name": "extraMarkers",
          "attribute": false,
          "type": "ExtraMarker[]"
        },
        {
          "name": "fixedOverflowWidgets",
          "description": "",
          "default": "true",
          "type": "boolean"
        },
        {
          "name": "spellCheck",
          "description": "是否启用英语拼写检查",
          "default": "true",
          "type": "boolean"
        },
        {
          "name": "knownWords",
          "description": "启用英语拼写检查时，除系统设置的词汇表外，指定其他的已知单词（小写）。",
          "attribute": false,
          "type": "string[]"
        },
        {
          "name": "domLibsEnabled",
          "description": "是否启用 DOM 相关接口的自动提示。",
          "type": "boolean"
        },
        {
          "name": "uri",
          "type": "string"
        }
      ],
      "events": [
        {
          "name": "code.change",
          "detail": {
            "type": "string"
          }
        },
        {
          "name": "user.input",
          "detail": {
            "type": "any"
          }
        },
        {
          "name": "token.click",
          "detail": {
            "type": "string"
          }
        }
      ],
      "slots": [],
      "methods": [],
      "parts": [],
      "description": "构件代码编辑器",
      "category": "form-input-advanced"
    }
  ],
  "providers": []
}